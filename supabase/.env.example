# Edge Function secrets — set these in Supabase, never in the React/Vite client.
PUBLIC_SITE_URL=https://your-villa-domain.com
BOOKING_HOLD_HOURS=24

# Email notifications (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Villa Floyd <bookings@your-domain.com>
OWNER_EMAIL=owner@example.com

# Google Calendar service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=villa-floyd-calendar@your-google-cloud-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
